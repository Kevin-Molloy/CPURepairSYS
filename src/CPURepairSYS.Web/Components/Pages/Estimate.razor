@page "/repairs/{RepairId:int}/estimate"
@rendermode InteractiveServer
@inject RepairFacade RepairOperations
@inject InventoryFacade InventoryOperations

<PageTitle>Create estimate</PageTitle>
<h1>Create estimate for repair @RepairId</h1>

<section class="form-card">
    <div class="form-grid">
        <label>Part name <InputText @bind-Value="partSearch" /></label>
        <label>Part type
            <InputSelect @bind-Value="partType">
                <option value="">All types</option>
                @foreach (var type in PartTypes)
                {
                    <option value="@type">@type</option>
                }
            </InputSelect>
        </label>
        <label>Quantity <InputNumber @bind-Value="quantity" /></label>
    </div>
    <button @onclick="SearchPartsAsync">Search parts</button>
    @if (partResults is not null)
    {
        <InputSelect TValue="int" @bind-Value="selectedPartId">
            <option value="0">Select a part</option>
            @foreach (var part in partResults)
            {
                <option value="@part.Id.Value">@part.Description (@part.PartTypeCode)</option>
            }
        </InputSelect>
        <button type="button" @onclick="AddLine">Add part</button>
    }
    <button @onclick="SaveAsync" disabled="@(lines.Count == 0)">Save estimate</button>
</section>

<PageErrors Errors="errors" />

<table>
    <thead><tr><th>Part ID</th><th>Quantity</th><th></th></tr></thead>
    <tbody>
    @foreach (var line in lines)
    {
        <tr><td>@line.PartId.Value</td><td>@line.Quantity</td><td><button @onclick="() => lines.Remove(line)">Remove</button></td></tr>
    }
    </tbody>
</table>

@code {
    [Parameter] public int RepairId { get; set; }
    private string? partSearch;
    private string? partType;
    private int selectedPartId;
    private int quantity = 1;
    private List<EstimateLineRequest> lines = new();
    private IReadOnlyList<ValidationError> errors = Array.Empty<ValidationError>();
    private IReadOnlyList<PartSummary>? partResults;
    private static readonly string[] PartTypes = ["PROC", "GCARD", "FAN", "CASE", "BATT", "POWSUP", "MTHBRD", "COOL", "RAM", "STOR", "WIFIADAP", "SCRN", "MULT", "OTH"];

    private async Task SearchPartsAsync()
    {
        selectedPartId = 0;
        try
        {
            var result = await InventoryOperations.SearchPartsForEstimateAsync(partSearch, partType);
            errors = result.Errors;
            partResults = result.Value;
            if (result.Succeeded)
            {
                if (partResults is null || partResults.Count == 0)
                {
                    errors = new[] { new ValidationError(nameof(partResults), "No available parts matched the search.") };
                }
                else
                {
                    selectedPartId = partResults[0].Id.Value;
                }
            }
        }
        catch (Exception exception)
        {
            errors = UserFacingErrors.From(exception);
        }
    }

    private void AddLine()
    {
        if (quantity <= 0) errors = new[] { new ValidationError(nameof(quantity), "Quantity must be positive.") };
        else if (selectedPartId == 0) errors = new[] { new ValidationError(nameof(selectedPartId), "Select a part.") };
        else { lines.Add(new EstimateLineRequest(new PartId(selectedPartId), quantity)); errors = Array.Empty<ValidationError>(); }
    }

    private async Task SaveAsync()
    {
        try
        {
            var result = await RepairOperations.CreateEstimateAsync(new RepairId(RepairId), lines);
            errors = result.Errors;
            if (result.Succeeded)
            {
                Navigation.NavigateTo($"/repairs/{RepairId}?notice=estimated");
            }
        }
        catch (Exception exception) { errors = UserFacingErrors.From(exception); }
    }

    [Inject] private NavigationManager Navigation { get; set; } = null!;
}