    private void AddLine()
    {
        if (quantity <= 0) errors = new[] { new ValidationError(nameof(quantity), "Quantity must be positive.") };
        else if (!int.TryParse(selectedPartId, out var partId) || partId == 0) errors = new[] { new ValidationError(nameof(selectedPartId), "Select a part.") };
        else if (lines.Any(line => line.PartId.Value == partId)) errors = new[] { new ValidationError(nameof(selectedPartId), "Part is already selected.") };
        else { lines.Add(new EstimateLineRequest(new PartId(partId), quantity)); errors = Array.Empty<ValidationError>(); }
    }

    private async Task SaveAsync()
    {
        busy = true;
        try
        {
            var result = await RepairOperations.CreateEstimateAsync(new RepairId(RepairId), lines);
            errors = result.Errors;
            if (result.Succeeded) Navigation.NavigateTo($"/repairs/{RepairId}");
        }
        catch (Exception exception) { errors = UserFacingErrors.From(exception); }
        finally { busy = false; }
    }

    [Inject] private NavigationManager Navigation { get; set; } = null!;
}
