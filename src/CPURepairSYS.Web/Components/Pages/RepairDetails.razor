@page "/repairs/{RepairId:int}"
@rendermode InteractiveServer
@inject RepairFacade RepairOperations

<PageTitle>Repair details</PageTitle>
<h1>Repair details</h1>

@if (repair is null && errors.Count == 0)
{
    <p>Loading repair...</p>
}
else if (repair is not null)
{
    <dl class="details">
        <dt>ID</dt><dd>@repair.Id.Value</dd>
        <dt>Description</dt><dd>@repair.Description</dd>
        <dt>Type</dt><dd>@repair.RepairTypeCode</dd>
        <dt>Status</dt><dd>@repair.Status</dd>
        <dt>Price</dt><dd>@repair.Price</dd>
        <dt>Start date</dt><dd>@repair.StartDate</dd>
    </dl>
    <div class="actions">
        <button @onclick="ApproveAsync" disabled="@(!CanApprove)">Approve</button>
        <button @onclick="CancelAsync" disabled="@(!CanCancel)">Cancel repair</button>
        <button @onclick="CompleteAsync" disabled="@(!CanComplete)">Complete</button>
        @if (repair.Status == RepairStatus.Logged)
        {
            <a class="button-link" href="/repairs/@RepairId/estimate">Create estimate</a>
        }
    </div>
    @if (repair.Price.Amount <= 0)
    {
        <p>An estimate is required before this repair can be approved or completed.</p>
    }
}

<PageErrors Errors="errors" />
@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <p class="success">@successMessage</p>
}

@code {
    [Parameter] public int RepairId { get; set; }
    private RepairSummary? repair;
    private bool busy;
    private IReadOnlyList<ValidationError> errors = Array.Empty<ValidationError>();
    private string? successMessage;

    private bool HasEstimate => repair is not null && repair.Price.Amount > 0;
    private bool CanApprove => !busy && repair?.Status == RepairStatus.Estimated && HasEstimate;
    private bool CanComplete => !busy && repair?.Status == RepairStatus.Approved && HasEstimate;
    private bool CanCancel => !busy && repair?.Status is RepairStatus.Logged or RepairStatus.Estimated or RepairStatus.Approved;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            var result = await RepairOperations.GetRepairAsync(new RepairId(RepairId));
            repair = result.Value;
            errors = result.Errors;
        }
        catch (Exception exception)
        {
            errors = UserFacingErrors.From(exception);
        }
    }

    private Task ApproveAsync() => TransitionAsync(
        () => RepairOperations.ApproveRepairAsync(new RepairId(RepairId), DateOnly.FromDateTime(DateTime.Today)),
        "Repair approved successfully.");

    private Task CancelAsync() => TransitionAsync(
        () => RepairOperations.CancelRepairAsync(new RepairId(RepairId), DateOnly.FromDateTime(DateTime.Today)),
        "Repair cancelled successfully.");

    private Task CompleteAsync() => TransitionAsync(
        () => RepairOperations.CompleteRepairAsync(new RepairId(RepairId), DateOnly.FromDateTime(DateTime.Today)),
        "Repair completed successfully.");

    private async Task TransitionAsync(Func<Task<ApplicationResult<RepairSummary>>> operation, string successText)
    {
        busy = true;
        try
        {
            var result = await operation();
            repair = result.Value ?? repair;
            errors = result.Errors;
            if (result.Succeeded)
            {
                successMessage = successText;
            }
        }
        catch (Exception exception) { errors = UserFacingErrors.From(exception); }
        finally { busy = false; }
    }
}
